+/* 0280 measurement-only hook: dump the exact 307,200-byte panel raster so the
+ * host can render the fresh shoot.  Not part of the shipped build. */
+static void dump_raster(void)
+{
+    if (s_frame == NULL || !s_have_frame) { Serial.println("raster  : no frame captured yet"); return; }
+    char hex[65];
+    sha_hex(s_frame, FB_BYTES, hex);
+    Serial.printf("raster  : BEGIN %u %s wb %.2f\n", (unsigned)FB_BYTES, hex, (double)WB_STRENGTH);
+    Serial.flush();
+    Serial.write(s_frame, FB_BYTES);
+    Serial.flush();
+    Serial.printf("\nraster  : END\n");
+}
