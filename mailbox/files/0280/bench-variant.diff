+/* 0280 bench A/B: dump the exact 307,200-byte panel raster (1 byte per pixel,
+ * 6 bits used: R=bits0-1, G=2-3, B=4-5) so the host can compare variants
+ * without a camera pointed at the panel.  Header carries the knobs, the length
+ * and the firmware's own SHA-256 of the buffer; the host verifies the SHA. */
+static void dump_raster(void)
+{
+    if (s_frame == NULL || !s_have_frame) { Serial.println("raster  : no frame captured yet"); return; }
+    char hex[65];
+    sha_hex(s_frame, FB_BYTES, hex);
+    Serial.printf("raster  : BEGIN %u %s wb %.2f sat %d\n", (unsigned)FB_BYTES, hex,
+                  (double)WB_STRENGTH, (int)SAT_LEVEL);
+    Serial.flush();
+    Serial.write(s_frame, FB_BYTES);
+    Serial.flush();
+    Serial.printf("\nraster  : END\n");
+}
