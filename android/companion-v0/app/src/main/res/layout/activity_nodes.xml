<?xml version="1.0" encoding="utf-8"?>
<!--
  Screen 1 shell — Property overview (UI spec v2, task 0090).

  The shell owns what every screen shares: the thin "PROTOTYPE – MOCK DATA"
  banner, the scroll container the screen content is built into, and the bottom
  nav. The content itself is built from the API by Screens.propertyOverview(),
  because every value on it comes from WildfireApi.

  The window is padded by the real system-bar insets in the activity
  (WindowInsetsHelper) — edge-to-edge, so this layout owns the whole screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nodes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nt_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/prototype_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nt_surface_2"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/prototype_banner"
        android:textColor="@color/nt_accent"
        android:textSize="9sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/screen_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingTop="10dp"
            android:paddingEnd="17dp"
            android:paddingBottom="20dp" />
    </ScrollView>

    <include
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
