<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark shell (0049). The v0.1 screens are dark-first, exactly like the
         approved mockup, so the theme base is AppCompat's dark theme and the
         window background is the mockup's dark background — the screens, not an
         action bar, paint everything. NoActionBar is still required: since 0047
         the app runs edge-to-edge (targetSdk 35) and each screen owns its own
         header row rather than letting the decor draw one over the content. -->
    <style name="Theme.Companion" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/nt_accent</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/nt_accent</item>
        <item name="android:windowBackground">@color/nt_bg</item>
        <item name="android:textColorPrimary">@color/nt_ink</item>
        <item name="android:textColorSecondary">@color/nt_muted</item>
    </style>

    <!-- Splash theme for the launcher activity (0048). Its parent carries every
         window attribute, so it is a drop-in replacement: the activity keeps
         this theme for its whole life. values-v31 overrides it with the Android
         12+ SplashScreen attributes, which is why the two are separate names
         instead of a partial re-declaration of Theme.Companion. -->
    <style name="Theme.Companion.Start" parent="Theme.Companion" />
</resources>
