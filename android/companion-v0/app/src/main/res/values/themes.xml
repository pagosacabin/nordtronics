<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NoActionBar (0047): the framework/AppCompat action bar is drawn *over*
         the content when the app runs edge-to-edge (Android 15+, targetSdk 35),
         which hid this screen's toolbar underneath the "Nodes" header. Each
         screen now owns its header bar in its own layout and pads the window by
         the real system-bar insets — see WindowInsetsHelper. -->
    <style name="Theme.Companion" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/companion_primary</item>
        <item name="colorPrimaryDark">@color/companion_primary_dark</item>
        <item name="colorAccent">@color/companion_accent</item>
        <item name="android:windowBackground">@color/companion_window</item>
    </style>

    <!-- Splash theme for the launcher activity (0048). Its parent carries every
         window attribute, so it is a drop-in replacement: the activity keeps
         this theme for its whole life. values-v31 overrides it with the Android
         12+ SplashScreen attributes, which is why the two are separate names
         instead of a partial re-declaration of Theme.Companion. -->
    <style name="Theme.Companion.Start" parent="Theme.Companion" />
</resources>
