<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug network policy: HTTPS by default, cleartext to the local mock only.

  This file overrides app/src/main/res/xml/network_security_config.xml for the
  debug build type. The mock backend is plaintext HTTP on the host machine's
  loopback interface, reached from the emulator at 10.0.2.2:8000 (the dev
  override in app/build.gradle), so that one host is excepted and every other
  cleartext destination stays denied. The release build type gets no exception
  at all.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
